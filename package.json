{
  "name": "paymailhook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:web": "vite",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "biome check . && tsc --noEmit && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "vite build",
    "build:worker": "vite build && bun node_modules/wrangler/bin/wrangler.js deploy --dry-run --outdir dist/worker",
    "deploy": "vite build && wrangler deploy",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.5",
    "@hono/mcp": "^0.3.2",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "imapflow": "^2.0.6",
    "lucide-react": "^1.48.0",
    "mailauth": "^5.0.3",
    "marked": "^18.0.14",
    "next-themes": "^0.4.6",
    "postal-mime": "^3.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vietnam-qr-pay": "^1.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
  }
}

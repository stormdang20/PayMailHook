DATABASE_URL=postgres://postgres:postgres@localhost:5435/paymailhook
ENCRYPTION_KEY=            # openssl rand -base64 32
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3010
PORT=3010
ALLOW_SIGNUP=true
ALLOW_PRIVATE_WEBHOOKS=true
GOOGLE_CLIENT_ID=          # optional: enables "Sign in with Google"
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=           # optional Web Push: bun scripts/generate-vapid.ts
VAPID_PRIVATE_KEY=
GOOGLE_PUBSUB_TOPIC=        # optional Gmail OAuth source: projects/<project>/topics/<topic>
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
INBOUND_EMAIL_DOMAIN=       # optional forwarding source: a Cloudflare Email Routing domain, e.g. in.example.com
INBOUND_WEBHOOK_SECRET=     # self-host only: shared with deploy/email-relay (openssl rand -hex 32)
